# pwm config.toml example
#
# Copy this file to ~/.config/pwm/config.toml (or
# $XDG_CONFIG_HOME/pwm/config.toml) and uncomment/edit whatever you want to
# change. Everything here is optional - anything you leave out keeps pwm's
# built-in default, and a missing or invalid config.toml never stops pwm
# from starting.
#
# This file is only read once, at startup - there is no hot reload yet, so
# changes need a logout/login (or a fresh `startx`) to take effect.

# ── Theme ────────────────────────────────────────────────────────────────
# Built-in themes: d77 (default), gruvbox_dark, arc_dark, dracula,
# tokyo_night. An unknown name here falls back to d77 with a warning.
[theme]
# active = "d77"

# You can also define your own theme, or override a built-in one by reusing
# its name. Colors are hex strings - "0xRRGGBBAA", "0xRRGGBB", "#RRGGBBAA"
# and "#RRGGBB" all work (a missing alpha defaults to fully opaque).
# [theme.my_theme]
# black  = "#282828"
# white  = "#ebdbb2"
# grey   = "#3c3836"
# accent = "#aa96da"
# font   = "JetBrainsMono Nerd Font"

# ── Applications ─────────────────────────────────────────────────────────
[apps]
# terminal = "st"
# launcher = "dmenu_run"
# locker = "slock"
# startup_script runs with the active theme's name as its first argument
# (e.g. "startup.sh gruvbox_dark") - the shipped script uses it to pick
# matching wallpaper art. A script that ignores its arguments still works.
# startup_script = "/etc/xdg/pwm/startup.sh"

# ── Window rules ─────────────────────────────────────────────────────────
# Which window class opens on which tag. Rules here are overlaid onto the
# built-in list by class: one for a class already covered below replaces
# just its workspace, a new class gets added, and any class you don't
# mention keeps its default rule (gimp -> 3, mpv/deadbeef/ncspot/spotify ->
# 5, thunderbird/chromium/firefox/qutebrowser -> 9).
# [[window_rule]]
# class = "firefox"
# workspace = "9"

# [[window_rule]]
# class = "mpv"
# workspace = "5"

# ── Floating windows ─────────────────────────────────────────────────────
# Make specific window classes float, centered, instead of tiling - handy
# for popups/dialogs like d77run, pavucontrol, or a picture-in-picture
# player. width_ratio/height_ratio (0.0-1.0) size the floating window
# relative to the screen; either one defaults to 0.6 if left out, and an
# out-of-range value is clamped into 0.0..=1.0. Unlike [[window_rule]],
# there's no built-in list here - a window only floats if you add a rule
# for its class.
# [[float_rule]]
# class = "Pavucontrol"
# width_ratio = 0.5
# height_ratio = 0.5

# ── Status bar ───────────────────────────────────────────────────────────
# Which widgets show in the bar, and in what order. Available names:
# workspaces, layout, window_name, cpu, ram, volume, wifi, battery, clock.
[bar]
# widgets = [
#     "workspaces", "layout", "window_name",
#     "cpu", "ram", "volume", "wifi", "battery", "clock",
# ]

# ── Keybindings ──────────────────────────────────────────────────────────
# Remap or add keybindings. Entries here are overlaid onto the built-in
# keymap key by key: a [[bind]] for a key that already does something (e.g.
# "M-j") replaces just that one binding, every other default stays as-is.
# The one exception is toggle_scratchpad - it can only ever be bound to one
# key, so pointing a new key at it moves it off the default M-s rather than
# also keeping M-s bound to it. Key strings use the same format penrose
# expects elsewhere, e.g. "M-j", "M-S-Return", "XF86AudioRaiseVolume".
#
# Available actions:
#   focus_down, focus_up, swap_down, swap_up, kill_focused,
#   toggle_fullscreen, toggle_tag, next_screen, previous_screen,
#   next_layout, previous_layout, expand_main, shrink_main,
#   inc_main         (arg: a signed integer, e.g. "1" or "-1")
#   spawn_terminal, spawn_launcher, spawn_locker,
#   spawn            (arg: any shell command)
#   toggle_scratchpad (can only be bound once)
#   logout_menu, log_state, exit
#
# [[bind]]
# key = "M-j"
# action = "focus_down"
#
# [[bind]]
# key = "M-Return"
# action = "spawn_terminal"
#
# [[bind]]
# key = "M-Up"
# action = "inc_main"
# arg = "1"
#
# [[bind]]
# key = "M-S-q"
# action = "exit"
