super + a
	rofi -show drun
super + b
	wswap-X
super + p
	scrot
super + r
	gmrun

# Note: don't bind "super + t" here - pwm already binds it to lock the
# screen by default (see the Keybinds section in the main README), and the
# window manager grabs it first, so an sxhkd rule for it would never fire.
